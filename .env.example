HOST=127.0.0.1
PORT=4174
DATABASE_PATH=
DATABASE_BACKUP_DIR=
SESSION_SECRET=change-me
SECURE_COOKIES=false
# In production set either ADMIN_PASSWORD_HASH or ADMIN_PASSWORD.
# In local development the server falls back to admin1234 only if both are omitted.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
PUBLIC_SITE_URL=http://127.0.0.1:4174
PUBLIC_API_ALLOWED_ORIGINS=https://orenda-cherepashka.pages.dev
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=@arenda_cherepashka
TELEGRAM_AUTO_PUBLISH=true
TELEGRAM_ADMIN_CHAT_ID=

# Optional public storefront build settings. The publishable key is safe for the browser;
# never put SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PRODUCT_METADATA_MODE=auto
