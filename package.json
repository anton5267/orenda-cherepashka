{
  "name": "orenda-cherepashka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "docker:backup": "node scripts/docker-backup-db.mjs",
    "docker:doctor": "node scripts/docker-doctor.mjs",
    "docker:doctor:json": "node scripts/docker-doctor.mjs --json",
    "docker:down": "node scripts/docker-down.mjs",
    "docker:down:volumes": "node scripts/docker-down.mjs --volumes",
    "docker:init-env": "node scripts/docker-init-env.mjs",
    "docker:logs": "node scripts/docker-logs.mjs",
    "docker:logs:follow": "node scripts/docker-logs.mjs --follow",
    "docker:restore": "node scripts/docker-restore-db.mjs",
    "docker:self-qa": "node scripts/run-docker-self-qa.mjs",
    "docker:status": "node scripts/docker-status.mjs",
    "docker:status:json": "node scripts/docker-status.mjs --json",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:up:nobuild": "node scripts/docker-up.mjs --no-build",
    "local:start": "powershell -ExecutionPolicy Bypass -File ./start-local.ps1",
    "local:status": "powershell -ExecutionPolicy Bypass -File ./status-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File ./stop-local.ps1",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "ci:verify": "npm run typecheck && npm run self-qa:admin-recovery && npm run self-qa:catalog-prices && npm run self-qa:news-dates && npm run self-qa:news-merge && npm run self-qa:telegram-public-feed && npm run self-qa:news-metadata && npm run self-qa:supabase-seed && npm run self-qa:supabase-api-keys && npm run self-qa:product-metadata && npm run self-qa:price-format && npm run build && npm run self-qa:telegram-webhook-config && npm run self-qa:rate-limits && npm run self-qa:backup && npm run self-qa:catalog-migration && npm run self-qa:local && npm run build:pages && npm run self-qa:pages && npm run self-qa:pages-api && npm run self-qa:cloudflare",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.json --noEmit && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node server-dist/server/index.js",
    "self-qa": "npm run self-qa:browser && npm run self-qa:admin",
    "self-qa:browser": "node scripts/self-qa.mjs",
    "self-qa:admin": "node scripts/admin-api-smoke.mjs",
    "self-qa:auth-recovery": "node scripts/auth-recovery-self-qa.mjs",
    "self-qa:admin-recovery": "node scripts/admin-password-recovery-smoke.mjs",
    "self-qa:backup": "node scripts/database-backup-smoke.mjs",
    "self-qa:rate-limits": "node scripts/rate-limit-cleanup-smoke.mjs",
    "self-qa:telegram-webhook-config": "node scripts/telegram-webhook-config-smoke.mjs",
    "self-qa:news-dates": "tsx scripts/news-date-smoke.ts",
    "self-qa:news-merge": "tsx scripts/news-merge-smoke.ts",
    "self-qa:telegram-public-feed": "tsx scripts/telegram-public-feed-smoke.ts",
    "self-qa:news-metadata": "tsx scripts/news-metadata-source-smoke.ts",
    "self-qa:supabase-seed": "tsx scripts/supabase-seed-smoke.ts",
    "self-qa:supabase-api-keys": "tsx scripts/supabase-api-key-headers-smoke.ts",
    "self-qa:product-metadata": "tsx scripts/product-metadata-source-smoke.ts",
    "self-qa:price-format": "tsx scripts/price-format-smoke.ts",
    "self-qa:catalog-prices": "tsx scripts/catalog-prices-smoke.ts",
    "self-qa:catalog-migration": "node scripts/catalog-migration-smoke.mjs",
    "self-qa:pages": "node scripts/pages-self-qa.mjs",
    "self-qa:pages-api": "node scripts/pages-api-self-qa.mjs",
    "self-qa:cloudflare": "node scripts/cloudflare-self-qa.mjs",
    "self-qa:local": "node scripts/run-local-self-qa.mjs",
    "supabase:import-content": "tsx scripts/import-supabase-content.ts",
    "supabase:export-content-sql": "tsx scripts/export-supabase-content-sql.ts",
    "supabase:verify-backup": "node scripts/verify-supabase-backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.1",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "vite": "6.4.3"
  }
}
