{
  "name": "orenda-cherepashka",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "docker:backup": "node scripts/docker-backup-db.mjs",
    "docker:doctor": "node scripts/docker-doctor.mjs",
    "docker:doctor:json": "node scripts/docker-doctor.mjs --json",
    "docker:down": "node scripts/docker-down.mjs",
    "docker:down:volumes": "node scripts/docker-down.mjs --volumes",
    "docker:init-env": "node scripts/docker-init-env.mjs",
    "docker:logs": "node scripts/docker-logs.mjs",
    "docker:logs:follow": "node scripts/docker-logs.mjs --follow",
    "docker:restore": "node scripts/docker-restore-db.mjs",
    "docker:self-qa": "node scripts/run-docker-self-qa.mjs",
    "docker:status": "node scripts/docker-status.mjs",
    "docker:status:json": "node scripts/docker-status.mjs --json",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:up:nobuild": "node scripts/docker-up.mjs --no-build",
    "local:start": "powershell -ExecutionPolicy Bypass -File ./start-local.ps1",
    "local:status": "powershell -ExecutionPolicy Bypass -File ./status-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File ./stop-local.ps1",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "ci:verify": "npm run typecheck && npm run build && npm run self-qa:local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node server-dist/server/index.js",
    "self-qa": "npm run self-qa:browser && npm run self-qa:admin",
    "self-qa:browser": "node scripts/self-qa.mjs",
    "self-qa:admin": "node scripts/admin-api-smoke.mjs",
    "self-qa:local": "node scripts/run-local-self-qa.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
